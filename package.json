{
  "name": "ikataster",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ikataster/web",
    "build": "npm run build -w @ikataster/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:runner": "node scripts/tests/workspace-exit.mjs",
    "test:browser": "npm run build && node scripts/tests/browser.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.58.2"
  }
}
