# Static hosting headers (Cloudflare Pages). Mirrors nginx.conf.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org https://ipi.eprostor.gov.si; connect-src 'self' https://errors.bracic.dev https://tiles.openfreemap.org https://ipi.eprostor.gov.si https://raw.githubusercontent.com; worker-src 'self' blob:; font-src 'self' data:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Cache-Control: no-cache

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate

/mirror/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/mirror/tiles/*
  Content-Type: application/x-protobuf
